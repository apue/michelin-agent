{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/michelin-maps/review-overrides.schema.json",
  "title": "Michelin Maps agent review overrides",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source_ids", "expected_title", "expected_address"],
    "properties": {
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "query": {"type": "string", "minLength": 1},
      "maps_url": {"type": "string", "format": "uri", "pattern": "^https://"},
      "expected_title": {"type": "string", "minLength": 1},
      "expected_address": {"type": "string", "minLength": 1},
      "note": {"type": "string", "minLength": 1}
    },
    "anyOf": [
      {"required": ["query"]},
      {"required": ["maps_url"]}
    ],
    "additionalProperties": false
  }
}
